{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gaming-store",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "gaming-store"],
      "port": 8080
    },
    {
      "name": "storefront",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "storefront", "run", "dev"],
      "port": 5173
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "admin", "run", "dev"],
      "port": 5174
    },
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--reload", "--port", "8000"],
      "port": 8000
    }
  ]
}
