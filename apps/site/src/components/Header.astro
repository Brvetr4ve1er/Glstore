---
import site from '~/content/site.json';
// Normalise: Astro yields '/galerie/' while hrefs are '/galerie' — strip
// the trailing slash so the active-nav comparison actually matches.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
/* shortLabel kicks in below 480px viewports to avoid the nav overflowing. */
const links = [
  { href: '/',         label: 'Accueil',       shortLabel: 'Home' },
  { href: '/custom',   label: 'Personnaliser', shortLabel: 'Design' },
  { href: '/galerie',  label: 'Galerie',       shortLabel: 'Galerie' },
  { href: '/boutique', label: 'Notre shop',    shortLabel: 'Shop' },
];
---
<header>
  <div class="wrap nav">
    <a class="brand" href="/">
      <img src="/assets/mascot.svg" alt="" width="40" height="40" />
      <span class="word">{site.brand.name}<span class="kanji-small">{site.brand.kanji}</span></span>
    </a>
    <nav>
      {links.map(l => (
        <a href={l.href} class={path === l.href ? 'on' : ''}>
          <span class="nav-long">{l.label}</span>
          <span class="nav-short">{l.shortLabel}</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 250, 247, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--sumi-4);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-3);
    padding-bottom: var(--s-3);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--sumi);
  }
  .word {
    font-family: var(--f-display);
    font-size: 24px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .kanji-small {
    font-family: var(--f-kanji);
    font-size: 14px;
    color: var(--torii);
    margin-left: 4px;
    vertical-align: top;
  }
  nav { display: flex; gap: 4px; }
  nav a {
    font-family: var(--f-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sumi);
    padding: 8px 12px;
    border-radius: var(--r-2);
    transition: all 0.2s;
  }
  nav a:hover { background: var(--washi-2); color: var(--sumi); }
  nav a.on { background: var(--torii); color: var(--white); }
  .nav-short { display: none; }
  /* Tablet: tighten the nav so it never overflows */
  @media (max-width: 600px) {
    .word { font-size: 20px; }
    .kanji-small { display: none; }
    nav { gap: 2px; }
    nav a { padding: 6px 8px; font-size: 11px; letter-spacing: 0.06em; }
  }
  /* Mobile ≤480: use the short labels so we fit on a 360-wide phone */
  @media (max-width: 480px) {
    .nav { gap: 8px; padding-left: 4px; padding-right: 4px; }
    .nav .brand { gap: 6px; }
    .nav .brand img { width: 28px; height: 28px; }
    .word { font-size: 15px; letter-spacing: 0.04em; }
    nav { gap: 1px; }
    nav a { padding: 5px 6px; font-size: 10px; letter-spacing: 0.03em; }
    nav a.on { padding: 5px 8px; }
    .nav-long { display: none; }
    .nav-short { display: inline; }
  }
  /* Very narrow (≤360 — small Androids in landscape mode): drop the wordmark, keep mascot */
  @media (max-width: 360px) {
    .word { display: none; }
  }
</style>
