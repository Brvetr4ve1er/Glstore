---
import site from '~/content/site.json';
const path = Astro.url.pathname;
const links = [
  { href: '/',         label: 'Accueil' },
  { href: '/custom',   label: 'Personnaliser' },
  { href: '/boutique', label: 'Notre shop' },
];
---
<header>
  <div class="wrap nav">
    <a class="brand" href="/">
      <img src="/assets/mascot.svg" alt="" width="40" height="40" />
      <span class="word">{site.brand.name}<span class="kanji-small">{site.brand.kanji}</span></span>
    </a>
    <nav>
      {links.map(l => (
        <a href={l.href} class={path === l.href ? 'on' : ''}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 250, 247, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--sumi-4);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-3);
    padding-bottom: var(--s-3);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--sumi);
  }
  .word {
    font-family: var(--f-display);
    font-size: 24px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .kanji-small {
    font-family: var(--f-kanji);
    font-size: 14px;
    color: var(--torii);
    margin-left: 4px;
    vertical-align: top;
  }
  nav { display: flex; gap: 4px; }
  nav a {
    font-family: var(--f-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sumi);
    padding: 8px 12px;
    border-radius: var(--r-2);
    transition: all 0.2s;
  }
  nav a:hover { background: var(--washi-2); color: var(--sumi); }
  nav a.on { background: var(--torii); color: var(--white); }
  @media (max-width: 600px) {
    .word { font-size: 20px; }
    nav a { padding: 8px 10px; font-size: 12px; }
  }
</style>
