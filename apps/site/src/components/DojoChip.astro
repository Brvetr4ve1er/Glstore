---
/* Header rank chip: progress ring + current rank. Filled in by dojo-ui. */
---
<a href="/dojo/" class="dojo-chip" data-dojo-chip aria-label="Le Dojo" style="--p:0">
  <span class="dc-ring" aria-hidden="true"><span class="dc-kanji">見習</span></span>
  <span class="dc-text" aria-hidden="true"><span class="dc-name">Dojo</span><span class="dc-pts">0 chakra</span></span>
</a>

<style>
  .dojo-chip {
    display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--sumi);
    padding: 3px 10px 3px 3px; border-radius: var(--r-pill); border: 1px solid var(--sumi-4);
    background: var(--washi); transition: border-color 0.2s, box-shadow 0.2s; flex-shrink: 0;
  }
  .dojo-chip:hover { border-color: var(--torii); box-shadow: var(--e-torii); color: var(--sumi); }
  :global(html[data-dojo="off"]) .dojo-chip { display: none; }
  .dc-ring {
    width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0;
    background: conic-gradient(var(--torii) calc(var(--p) * 1turn), var(--sumi-4) 0);
  }
  .dc-kanji {
    width: 28px; height: 28px; border-radius: 50%; background: var(--sumi); color: #fff;
    display: grid; place-items: center; font-family: var(--f-kanji); font-weight: 700; font-size: 11px; letter-spacing: -0.04em;
  }
  .dc-text { display: flex; flex-direction: column; line-height: 1.1; }
  .dc-name { font-family: var(--f-display); font-size: 14px; letter-spacing: 0.06em; text-transform: uppercase; }
  .dc-pts { font-size: 10px; color: var(--sumi-3); letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }
  @media (max-width: 1000px) {
    .dojo-chip { padding: 2px; }
    .dc-text { display: none; }
  }
  @media (max-width: 480px) {
    .dc-ring { width: 30px; height: 30px; }
    .dc-kanji { width: 25px; height: 25px; font-size: 10px; }
  }
</style>
