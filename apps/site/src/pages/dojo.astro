---
import Base from '~/layouts/Base.astro';
import site from '~/content/site.json';
import { getCollection } from 'astro:content';
import DesignThumb from '~/components/DesignThumb.astro';
import { RANKS, MISSIONS, ROLL_CHAKRA, REPEAT_ORDER_CHAKRA } from '~/lib/dojo';

const designs = (await getCollection('designs')).sort((a, b) => a.data.order - b.data.order);
const rewards = (site.dojo?.rewards ?? []).map(r => ({ rank: Number(r.rank), text: r.text }));
const pool = designs.map(d => ({
  id: d.data.id, name: d.data.name, anime: d.data.anime,
  image: d.data.image ?? null, emoji: d.data.emoji ?? null,
  rarity: d.data.rarity, unlockRank: d.data.unlockRank,
}));
const off = site.dojo?.enabled === false;
---
<Base title="Le Dojo" description="Gagne du chakra en créant tes designs, monte de Minarai à Shinobi, débloque des designs secrets et des cadeaux en boutique.">

  <section class="band-dark dojo-hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow" style="color: var(--gold);">Programme de fidélité</span>
        <h1 class="display" style="color:#fff; font-size: clamp(44px, 8vw, 88px); margin-top: var(--s-3);">
          Le Dojo <span class="kanji">道場</span>
        </h1>
        <p class="lead">
          Chaque design, chaque essayage, chaque commande te rapporte du <b>chakra 気</b>.
          Monte de <b>Minarai</b> à <b>Shinobi</b>, débloque des <b>designs secrets</b>
          et des <b>cadeaux</b> avec tes commandes.
        </p>
      </div>

      {off ? (
        <div class="rank-card"><p>Le dojo est fermé pour le moment. Reviens bientôt 🥷</p></div>
      ) : (
        <div class="rank-card" id="rank-card" aria-live="polite">
          <div class="rc-stamp"><span id="rc-kanji">見習</span></div>
          <div class="rc-body">
            <div class="rc-label">Ton rang</div>
            <div class="rc-name" id="rc-name">Minarai</div>
            <div class="rc-chakra"><b id="rc-chakra">0</b> chakra</div>
            <div class="rc-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="rc-bar">
              <span id="rc-fill"></span>
            </div>
            <div class="rc-next" id="rc-next">Encore 50 chakra pour Genin</div>
          </div>
        </div>
      )}
    </div>
  </section>

  {!off && (<>
  <!-- ── Daily invocation ─────────────────────────── -->
  <section class="section-sm" id="invocation">
    <div class="wrap inv">
      <div class="inv-copy">
        <span class="eyebrow">Une fois par jour</span>
        <h2 class="display h2">Invocation <span class="kanji">召喚</span></h2>
        <p class="muted">
          Invoque un design au hasard — commun, <span class="t-rare">rare</span> ou
          <span class="t-leg">légendaire</span>. Chaque invocation rapporte
          <b>+{ROLL_CHAKRA} chakra</b>. Le design invoqué t'attend dans le designer.
        </p>
        <p class="odds">Chances : commun 70 % · rare 25 % · légendaire 5 %</p>
      </div>
      <div class="inv-stage">
        <div class="inv-card" id="inv-card" data-rarity="">
          <div class="inv-thumb" id="inv-thumb"><span class="inv-q">?</span></div>
          <div class="inv-meta">
            <div class="inv-rarity" id="inv-rarity">Prêt</div>
            <div class="inv-name" id="inv-name">Concentre ton chakra…</div>
          </div>
        </div>
        <button type="button" class="btn btn-torii inv-btn" id="inv-btn">🌀 Invoquer</button>
        <a class="btn btn-sumi inv-btn" id="inv-go" href="/custom/" hidden>Le créer →</a>
        <p class="inv-wait muted" id="inv-wait" hidden></p>
      </div>
    </div>
  </section>

  <!-- ── Ranks ─────────────────────────────────────── -->
  <section class="section-sm band-light" id="rangs">
    <div class="wrap">
      <span class="eyebrow">5 rangs</span>
      <h2 class="display h2">La voie du shinobi</h2>
      <ol class="ladder">
        {RANKS.map(r => {
          const gifts = rewards.filter(x => x.rank === r.id && x.text);
          const secrets = designs.filter(d => d.data.unlockRank > 0 && d.data.unlockRank === r.id);
          return (
            <li class="rung" data-rank={r.id}>
              <div class="rung-stamp">{r.kanji}</div>
              <div class="rung-body">
                <div class="rung-head"><b>{r.name}</b><span>{r.min} chakra</span></div>
                <p class="rung-motto">{r.motto}</p>
                {(gifts.length > 0 || secrets.length > 0) && (
                  <ul class="rung-gifts">
                    {gifts.map(g => <li>🎁 {g.text}</li>)}
                    {secrets.map(d => (
                      <li class="rung-secret is-secret is-locked" data-unlock-rank={d.data.unlockRank}>
                        <span class="rs-thumb"><DesignThumb image={d.data.image} emoji={d.data.emoji} name={d.data.name} size={22} /></span>
                        <span><span class="rs-hide">Design secret</span><span class="rs-show">Design secret : <b>{d.data.name}</b></span></span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          );
        })}
      </ol>
      <p class="muted small">Les cadeaux sont ajoutés automatiquement à ton message de commande et confirmés par la boutique.</p>
    </div>
  </section>

  <!-- ── Missions ──────────────────────────────────── -->
  <section class="section-sm" id="missions">
    <div class="wrap">
      <span class="eyebrow" id="m-count">Missions</span>
      <h2 class="display h2">Tes missions</h2>
      <ul class="missions">
        {MISSIONS.map(m => (
          <li class="mission" data-mission={m.id} data-goal={m.goal ?? ''}>
            <span class="m-icon" aria-hidden="true">{m.icon}</span>
            <div class="m-body">
              <div class="m-title">{m.title}</div>
              <div class="m-desc">{m.desc}<span class="m-prog"></span></div>
            </div>
            <span class="m-pts">+{m.chakra}</span>
            {m.id === 'allie'
              ? <button type="button" class="m-go" id="allie">Partager</button>
              : <a class="m-go" href={m.href}>Go</a>}
            <span class="m-done" aria-label="Accomplie">✓</span>
          </li>
        ))}
      </ul>
      <p class="muted small">
        Bonus : <b>+{ROLL_CHAKRA}</b> par invocation quotidienne · <b>+{REPEAT_ORDER_CHAKRA}</b> par nouvelle commande.
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap fine">
      <p class="muted small">
        🔒 Ta progression est enregistrée <b>uniquement sur cet appareil</b> — pas de compte,
        pas de suivi. Si tu changes de téléphone ou effaces tes données, elle repart de zéro.
      </p>
      <button type="button" class="reset" id="dojo-reset">Recommencer à zéro</button>
    </div>
  </section>

  <script type="application/json" id="dojo-pool" set:html={JSON.stringify(pool)}></script>
  </>)}
</Base>

<script>
  import { initDojoPage } from '../scripts/dojo-page';
  initDojoPage();
</script>

<style>
  .dojo-hero { padding: var(--s-10) 0; }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--s-9); align-items: center; }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; gap: var(--s-7); } }
  .lead { color: var(--w70); margin-top: var(--s-4); max-width: 52ch; line-height: 1.7; }
  .lead b { color: #fff; }
  .h2 { font-size: clamp(28px, 4vw, 44px); margin: var(--s-3) 0 var(--s-6); }
  .small { font-size: 13px; }

  .rank-card {
    display: flex; gap: var(--s-6); align-items: center; color: #fff;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(215,163,58,0.35);
    border-radius: var(--r-4); padding: var(--s-7) var(--s-6);
  }
  .rc-stamp {
    width: 110px; height: 110px; flex-shrink: 0; border-radius: 50%; display: grid; place-items: center;
    background: radial-gradient(circle, #E00000, #A30000 72%); box-shadow: 0 0 36px rgba(224,0,0,0.45);
    outline: 2px dashed rgba(215,163,58,0.7); outline-offset: 6px;
    font-family: var(--f-kanji); font-weight: 700; font-size: 38px;
  }
  .rc-body { flex: 1; min-width: 0; }
  .rc-label { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); }
  .rc-name { font-family: var(--f-display); font-size: 46px; letter-spacing: 0.05em; text-transform: uppercase; line-height: 1; margin-top: 4px; }
  .rc-chakra { color: var(--w70); margin-top: 4px; }
  .rc-chakra b { color: #fff; font-family: var(--f-display); font-size: 22px; font-weight: 400; letter-spacing: 0.04em; }
  .rc-bar { height: 10px; background: var(--w10); border-radius: var(--r-pill); margin-top: var(--s-3); overflow: hidden; }
  .rc-bar span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--torii), var(--gold)); border-radius: inherit; transition: width 0.8s var(--ease-shuriken); }
  .rc-next { font-size: 13px; color: var(--w70); margin-top: 8px; }
  @media (max-width: 420px) { .rank-card { flex-direction: column; text-align: center; } }

  /* invocation */
  .inv { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-9); align-items: center; }
  @media (max-width: 820px) { .inv { grid-template-columns: 1fr; gap: var(--s-6); } }
  .t-rare { color: #1F4FA8; font-weight: 700; }
  .t-leg { color: #B8860B; font-weight: 700; }
  .odds { font-size: 12px; color: var(--sumi-3); margin-top: var(--s-3); letter-spacing: 0.02em; }
  .inv-stage { display: flex; flex-direction: column; align-items: center; gap: var(--s-4); }
  .inv-card {
    width: 100%; max-width: 300px; border-radius: var(--r-4); overflow: hidden;
    background: var(--sumi); color: #fff; border: 3px solid var(--sumi-4);
    box-shadow: var(--e-2); transition: border-color 0.3s, box-shadow 0.3s;
  }
  .inv-thumb {
    aspect-ratio: 1; display: grid; place-items: center; font-size: 96px;
    background: radial-gradient(circle at 50% 40%, #2a2a2a, #0E0E0E 70%);
  }
  .inv-q { font-family: var(--f-display); font-size: 110px; color: var(--w20); }
  .inv-meta { padding: var(--s-4); text-align: center; }
  .inv-rarity { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--w50); font-weight: 700; }
  .inv-name { font-family: var(--f-display); font-size: 24px; letter-spacing: 0.05em; text-transform: uppercase; margin-top: 4px; }
  .inv-card[data-rarity="rare"] { border-color: #3D74E0; box-shadow: 0 0 34px rgba(61,116,224,0.5); }
  .inv-card[data-rarity="rare"] .inv-rarity { color: #8FB1F5; }
  .inv-card[data-rarity="legendaire"] { border-color: var(--gold); box-shadow: 0 0 44px rgba(215,163,58,0.7); }
  .inv-card[data-rarity="legendaire"] .inv-rarity { color: var(--gold); }
  .inv-card.spinning .inv-thumb { animation: pulse 0.18s infinite alternate; }
  .inv-card.reveal { animation: reveal 0.55s var(--ease-koi); }
  @keyframes pulse { to { filter: brightness(1.4); } }
  @keyframes reveal { 0% { transform: scale(0.9) rotateY(70deg); } 100% { transform: none; } }
  .inv-btn { min-width: 220px; justify-content: center; }
  .inv-btn[hidden] { display: none; }
  .inv-wait { font-size: 13px; text-align: center; font-variant-numeric: tabular-nums; }

  /* ladder */
  .ladder { list-style: none; display: grid; gap: var(--s-3); margin-bottom: var(--s-4); }
  .rung {
    display: flex; gap: var(--s-4); align-items: flex-start; background: var(--washi);
    border: 1px solid var(--sumi-4); border-radius: var(--r-3); padding: var(--s-4); opacity: 0.6;
    transition: opacity 0.3s, border-color 0.3s;
  }
  .rung.reached { opacity: 1; }
  .rung.current { border-color: var(--torii); box-shadow: var(--e-torii); opacity: 1; }
  .rung-stamp {
    width: 52px; height: 52px; flex-shrink: 0; border-radius: 50%; display: grid; place-items: center;
    background: var(--sumi-4); color: var(--sumi-2); font-family: var(--f-kanji); font-weight: 700; font-size: 16px;
  }
  .rung.reached .rung-stamp { background: var(--torii); color: #fff; }
  .rung-body { flex: 1; min-width: 0; }
  .rung-head { display: flex; justify-content: space-between; gap: var(--s-3); align-items: baseline; }
  .rung-head b { font-family: var(--f-display); font-size: 22px; letter-spacing: 0.05em; text-transform: uppercase; font-weight: 400; }
  .rung-head span { font-size: 12px; color: var(--sumi-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rung-motto { font-size: 13px; color: var(--sumi-2); margin-top: 2px; }
  .rung-gifts { list-style: none; margin-top: var(--s-3); display: grid; gap: 6px; }
  .rung-gifts li { font-size: 13px; background: var(--washi-2); border-radius: var(--r-2); padding: 8px 10px; display: flex; gap: 8px; align-items: center; }
  .rs-thumb { width: 28px; height: 28px; display: grid; place-items: center; }
  .rs-show { display: none; }
  .rung-secret:not(.is-locked) .rs-show { display: inline; }
  .rung-secret:not(.is-locked) .rs-hide { display: none; }

  /* missions */
  .missions { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--s-3); margin-bottom: var(--s-4); }
  @media (max-width: 420px) { .missions { grid-template-columns: 1fr; } }
  .mission {
    display: flex; align-items: center; gap: var(--s-3); background: var(--washi);
    border: 1px solid var(--sumi-4); border-radius: var(--r-3); padding: var(--s-3) var(--s-4);
  }
  .m-icon { font-size: 24px; width: 36px; text-align: center; flex-shrink: 0; }
  .m-body { flex: 1; min-width: 0; }
  .m-title { font-weight: 700; font-size: 14px; }
  .m-desc { font-size: 12px; color: var(--sumi-2); }
  .m-prog { margin-left: 6px; font-weight: 700; color: var(--torii); }
  .m-pts { font-family: var(--f-display); font-size: 16px; color: var(--torii); letter-spacing: 0.04em; white-space: nowrap; }
  .m-go {
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    border: 1px solid var(--sumi-4); background: var(--washi-2); color: var(--sumi);
    border-radius: var(--r-pill); padding: 8px 12px; cursor: pointer; white-space: nowrap;
  }
  .m-go:hover { border-color: var(--torii); color: var(--torii); }
  .m-done {
    display: none; width: 30px; height: 30px; border-radius: 50%; background: var(--jade); color: #fff;
    place-items: center; font-weight: 700; flex-shrink: 0;
  }
  .mission.done { background: rgba(46,139,87,0.06); border-color: rgba(46,139,87,0.35); }
  .mission.done .m-go { display: none; }
  .mission.done .m-done { display: grid; }
  .mission.done .m-pts { color: var(--jade); }

  .fine { max-width: 760px; text-align: center; }
  .reset { margin-top: var(--s-3); background: none; border: none; color: var(--sumi-3); text-decoration: underline; cursor: pointer; font-size: 12px; }
  .reset:hover { color: var(--err); }
</style>
