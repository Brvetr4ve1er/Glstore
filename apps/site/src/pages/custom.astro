---
import Base from '~/layouts/Base.astro';
import site from '~/content/site.json';
import { getCollection } from 'astro:content';

const bases = (await getCollection('bases')).sort((a, b) => a.data.order - b.data.order);
const designs = (await getCollection('designs')).sort((a, b) => a.data.order - b.data.order);

const catalog = {
  bases: bases.map(b => b.data),
  designs: designs.map(d => d.data),
  contact: { whatsappNumber: site.contact.whatsappNumber, instagram: site.contact.instagram },
  brand: site.brand,
};
---
<Base title="Designer" description="Importe ton design, on enlève le fond et on l'applique sur le produit. Commande sur WhatsApp.">

  <section class="band-light" style="padding: var(--s-9) 0;">
    <div class="wrap text-center">
      <span class="eyebrow">Designer · à la Printify</span>
      <h1 class="display" style="font-size: clamp(34px, 6vw, 60px); margin-top: var(--s-3);">
        Crée ton produit <span class="kanji">忍者</span>
      </h1>
      <p class="muted" style="max-width: 60ch; margin: var(--s-4) auto 0;">
        Choisis un produit, importe ton image (on enlève le fond automatiquement)
        ou prends un design de la galerie, place-le, puis commande sur WhatsApp.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap studio">

      <!-- ── LEFT: live mockup stage ─────────────────────── -->
      <div class="stage-col">
        <!-- Mockup vs photo (try-on) mode toggle -->
        <div class="stage-modes">
          <button id="mode-mockup" class="stage-mode on" type="button">🥷 Sur le produit</button>
          <button id="mode-photo"  class="stage-mode" type="button">📸 Sur ma photo</button>
        </div>

        <div class="stage-frame">
          <div id="stage" class="stage">
            <img id="mockup-img" alt="Aperçu du produit" />
            <div id="print-box" class="print-box"><span id="print-box-label">zone d'impression</span></div>
            <img id="design-el" class="design-el" alt="Ton design" />
            <div id="stage-hint" class="stage-hint">
              <div class="hint-emoji">🎨</div>
              <p>Choisis ou importe un design pour le voir ici</p>
            </div>
            <!-- Photo upload prompt (shown in photo mode without a photo) -->
            <label id="photo-prompt" class="photo-prompt" for="photo-file" style="display:none;">
              <div class="hint-emoji">📸</div>
              <p><b>Importe ta photo</b><br><span class="muted">vois le design sur toi avant de commander</span></p>
              <input id="photo-file" type="file" accept="image/*" hidden />
            </label>
            <div id="processing" class="processing">
              <div class="spinner"></div>
              <p id="processing-label">Traitement…</p>
            </div>
          </div>
        </div>

        <!-- recto / verso switcher -->
        <div id="side-switch" class="side-switch">
          <button data-edit-side="recto" class="side-tab on">Recto <span class="dot"></span></button>
          <button data-edit-side="verso" class="side-tab">Verso <span class="plus">+500 DA</span><span class="dot"></span></button>
          <button id="btn-clear-verso" class="clear-verso" style="display:none;" title="Retirer le design verso">✕</button>
        </div>

        <!-- placement controls -->
        <div class="place-controls">
          <label>Taille
            <input id="scale" type="range" min="15" max="160" value="85" />
          </label>
          <label>Rotation
            <input id="rot" type="range" min="-180" max="180" value="0" />
          </label>
          <div class="place-btns">
            <button id="btn-center" class="mini">Centrer</button>
            <button id="btn-fit" class="mini">Ajuster</button>
          </div>
        </div>
        <p class="place-tip muted">Glisse le design sur le produit pour le positionner.</p>
      </div>

      <!-- ── RIGHT: controls ─────────────────────────────── -->
      <div class="controls">

        <!-- 1. Product -->
        <div class="step">
          <h2 class="step-label"><span class="num">1</span> Produit</h2>
          <div class="opts" id="bases">
            {bases.map((b, i) => (
              <button class:list={['opt opt-base', i === 0 && 'on']} data-base={b.data.id}>
                <span class="icon">{b.data.icon}</span>
                <span class="name">{b.data.name}</span>
                <span class="price">{b.data.price.toLocaleString('fr-FR').replace(/,/g, ' ')} DA</span>
              </button>
            ))}
          </div>
        </div>

        <!-- 2. Colour -->
        <div class="step">
          <h2 class="step-label"><span class="num">2</span> Couleur</h2>
          <div class="swatches" id="colors"></div>
        </div>

        <!-- 3. Design -->
        <div class="step">
          <h2 class="step-label"><span class="num">3</span> Design</h2>
          <div class="tabs">
            <button id="tab-gallery" class="tab on">Galerie</button>
            <button id="tab-upload" class="tab">Mon design</button>
          </div>

          <!-- gallery -->
          <div id="panel-gallery" class="panel">
            <div class="gallery" id="gallery">
              {designs.map(d => (
                <button class="g-item" data-design={d.data.id}>
                  <span class="g-img">{d.data.image}</span>
                  <span class="g-name">{d.data.name}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- upload -->
          <div id="panel-upload" class="panel" style="display:none;">
            <label id="dropzone" class="dropzone" for="file">
              <div class="dz-emoji">⬆️</div>
              <div class="dz-title">Importe ton image</div>
              <div class="dz-sub muted">PNG, JPG · glisse-dépose ou clique · le fond est enlevé automatiquement</div>
              <input id="file" type="file" accept="image/*" hidden />
            </label>

            <div id="upload-tools" class="upload-tools" style="display:none;">
              <label class="tol-label">Sensibilité de la découpe
                <input id="tolerance" type="range" min="5" max="80" value="30" />
              </label>
              <div class="tool-btns">
                <button id="btn-eyedrop" class="mini" title="Clique une couleur de fond à enlever">🎯 Pipette</button>
                <button id="btn-ai" class="mini" title="Découpe par IA — idéal pour les photos">✨ Découpe IA</button>
                <button id="btn-keep" class="mini" title="Garder l'image telle quelle">↩︎ Original</button>
              </div>
              <p class="muted tiny">La découpe auto marche mieux sur un fond uni. « IA » télécharge un modèle (≈40 Mo) pour les photos.</p>
            </div>
          </div>
        </div>

        <!-- 4. Size -->
        <div class="step" id="step-size">
          <h2 class="step-label">
            <span class="num">4</span> Taille
            <button type="button" id="btn-size-guide" class="size-guide-link">Guide des tailles ↗</button>
          </h2>
          <div class="opts" id="sizes">
            <button class="opt size" data-size="S">S</button>
            <button class="opt size on" data-size="M">M</button>
            <button class="opt size" data-size="L">L</button>
            <button class="opt size" data-size="XL">XL</button>
            <button class="opt size" data-size="XXL">XXL</button>
          </div>
        </div>

        <!-- summary -->
        <div class="sum-card">
          <span class="eyebrow" style="color: var(--w70);">Total</span>
          <div class="total" id="total">—</div>
          <div class="brk" id="brk"></div>
          <textarea id="note" class="note-input" rows="2"
            placeholder="Note pour la boutique (optionnel) — couleur d'encre, taille du logo, instructions…"></textarea>
          <div class="actions">
            <button id="btn-order" class="btn btn-wa" disabled>💬 Commander sur WhatsApp</button>
            <button id="btn-download" class="btn btn-ghost" disabled>⬇️ Télécharger le visuel</button>
          </div>
          <p class="hint muted">
            Sur mobile, le visuel + le fichier d'impression partent directement
            dans WhatsApp. Sur ordi, ils se téléchargent et WhatsApp s'ouvre —
            joins-les au message.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div id="toast" class="toast"></div>

  <!-- ── Size-guide modal ──────────────────────────────────── -->
  <div id="size-guide" class="modal" role="dialog" aria-modal="true" aria-labelledby="sg-title" style="display:none;">
    <div class="modal-back" data-close></div>
    <div class="modal-card">
      <button type="button" class="modal-close" data-close aria-label="Fermer">✕</button>
      <h2 id="sg-title" class="display" style="font-size:24px;letter-spacing:0.04em;text-transform:uppercase;">
        Guide des tailles <span class="kanji">忍</span>
      </h2>
      <p class="muted sg-family" id="sg-family">—</p>

      <!-- Recommender -->
      <div class="sg-rec">
        <div class="eyebrow" style="color:var(--torii);">Trouve ta taille</div>
        <div class="sg-rec-row">
          <label>Taille (cm)<input type="number" id="sg-height" min="140" max="220" placeholder="175" /></label>
          <label>Poids (kg)<input type="number" id="sg-weight" min="35" max="160" placeholder="70" /></label>
        </div>
        <p class="sg-rec-out muted" id="sg-rec-out">Entre ta taille et ton poids — on te recommande une taille.</p>
        <button type="button" id="sg-apply" class="btn btn-torii sg-apply" style="display:none;">Choisir la taille —</button>
      </div>

      <!-- Table -->
      <div class="sg-tablewrap">
        <table class="sg-table" id="sg-table" aria-label="Mensurations">
          <thead>
            <tr><th>Taille</th><th>Poitrine (cm)</th><th>Longueur (cm)</th><th>Épaules (cm)</th><th>Manche (cm)</th></tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <p class="muted sg-note" id="sg-note">—</p>
      <p class="muted tiny">Mesures à plat ±1 cm. En cas de doute, écris-nous sur WhatsApp.</p>
    </div>
  </div>

  <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)}></script>
  <script>
    import { initBuilder } from '../scripts/builder';
    initBuilder();
  </script>

</Base>

<style>
  .studio {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-9);
    align-items: start;
  }
  @media (max-width: 920px) { .studio { grid-template-columns: 1fr; gap: var(--s-7); } }

  /* ── Stage ─────────────────────────────── */
  .stage-col { position: sticky; top: 90px; }
  @media (max-width: 920px) { .stage-col { position: static; } }
  .stage-modes { display: flex; gap: 8px; margin-bottom: var(--s-3); }
  .stage-mode {
    flex: 1; padding: 10px 12px; border: 1px solid var(--sumi-4); background: var(--washi);
    border-radius: var(--r-2); cursor: pointer; font-family: var(--f-body); font-size: 12px;
    font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sumi-2);
    transition: all 0.18s var(--ease-koi);
  }
  .stage-mode:hover { border-color: var(--sumi-3); }
  .stage-mode.on { background: var(--sumi); color: #fff; border-color: var(--sumi); }
  .photo-prompt {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: var(--s-3);
    border: 2px dashed var(--sumi-4); border-radius: var(--r-3);
    background: var(--washi-2); margin: var(--s-4); cursor: pointer;
    text-align: center; padding: var(--s-6);
  }
  .photo-prompt:hover { border-color: var(--torii); background: rgba(204,0,0,0.04); }
  .photo-prompt p { font-size: 14px; line-height: 1.5; }
  .photo-prompt b { font-family: var(--f-display); letter-spacing: 0.04em; text-transform: uppercase; font-size: 18px; color: var(--sumi); }
  .stage-frame {
    background:
      radial-gradient(circle at 50% 35%, rgba(204,0,0,0.06), transparent 60%),
      var(--washi-2);
    border: 1px solid var(--sumi-4);
    border-radius: var(--r-4);
    padding: var(--s-6);
    box-shadow: var(--e-1);
  }
  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    touch-action: none;
    user-select: none;
  }
  #mockup-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  .print-box {
    position: absolute;
    border: 2px dashed rgba(204,0,0,0.45);
    border-radius: 4px;
    pointer-events: none;
  }
  .print-box span {
    position: absolute; top: -10px; left: 8px;
    font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase;
    background: var(--washi-2); color: var(--torii); padding: 0 6px;
  }
  .design-el {
    position: absolute;
    cursor: grab;
    pointer-events: auto;
    will-change: left, top, transform;
    display: none;
    -webkit-user-drag: none;
  }
  .design-el:active { cursor: grabbing; }
  .stage-hint {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--s-3); color: var(--sumi-3); text-align: center; padding: var(--s-6);
    pointer-events: none;
  }
  .hint-emoji { font-size: 40px; opacity: 0.5; }
  .stage-hint p { font-size: 14px; max-width: 24ch; }
  .processing {
    position: absolute; inset: 0; display: none;
    flex-direction: column; align-items: center; justify-content: center; gap: var(--s-3);
    background: rgba(250,250,247,0.82); backdrop-filter: blur(2px);
    border-radius: var(--r-3); color: var(--sumi); font-size: 13px; font-weight: 600;
  }
  .spinner {
    width: 34px; height: 34px; border-radius: 50%;
    border: 3px solid var(--sumi-4); border-top-color: var(--torii);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .place-controls {
    display: grid; grid-template-columns: 1fr 1fr auto; gap: var(--s-4);
    align-items: end; margin-top: var(--s-5);
  }
  @media (max-width: 480px) { .place-controls { grid-template-columns: 1fr 1fr; } }
  .place-controls label {
    display: flex; flex-direction: column; gap: 6px;
    font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sumi-3);
  }
  .place-controls input[type=range] { width: 100%; accent-color: var(--torii); }
  .place-btns { display: flex; gap: 8px; }
  .mini {
    font-size: 12px; font-weight: 600; padding: 8px 12px;
    border: 1px solid var(--sumi-4); background: var(--washi); border-radius: var(--r-2);
    cursor: pointer; color: var(--sumi); transition: all 0.18s;
  }
  .mini:hover { border-color: var(--sumi-3); }
  .mini.on { background: var(--torii); color: #fff; border-color: var(--torii); }
  .place-tip { font-size: 12px; margin-top: var(--s-3); text-align: center; }

  /* ── Side switcher ─────────────────────── */
  .side-switch { display: flex; gap: 8px; margin-top: var(--s-5); align-items: stretch; }
  .side-tab {
    flex: 1; padding: 10px 8px; border: 2px solid var(--sumi-4); background: var(--washi);
    border-radius: var(--r-2); cursor: pointer; font-family: var(--f-display);
    letter-spacing: 0.06em; text-transform: uppercase; font-size: 14px; color: var(--sumi-2);
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    transition: all 0.18s var(--ease-koi);
  }
  .side-tab:hover { border-color: var(--sumi-3); }
  .side-tab.on { border-color: var(--torii); color: var(--torii); background: rgba(204,0,0,0.05); }
  .side-tab .plus { font-size: 10px; color: var(--sumi-3); font-family: var(--f-body); letter-spacing: 0; }
  .side-tab.on .plus { color: var(--torii); }
  .side-tab .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--jade); display: none; }
  .clear-verso {
    width: 40px; border: 1px solid var(--sumi-4); background: var(--washi);
    border-radius: var(--r-2); cursor: pointer; color: var(--err); font-weight: 700; font-size: 14px;
  }
  .clear-verso:hover { border-color: var(--err); background: rgba(192,39,59,0.05); }

  /* ── Note input ────────────────────────── */
  .note-input {
    width: 100%; margin-top: var(--s-4); background: rgba(255,255,255,0.06);
    border: 1px solid var(--w20); border-radius: var(--r-2); color: #fff;
    padding: 10px 12px; font-family: var(--f-body); font-size: 13px; resize: vertical; line-height: 1.5;
  }
  .note-input::placeholder { color: var(--w50); }
  .note-input:focus { outline: none; border-color: var(--w50); }

  /* ── Controls ──────────────────────────── */
  .controls { display: flex; flex-direction: column; gap: var(--s-5); }
  .step {
    background: var(--washi);
    border: 1px solid var(--sumi-4);
    border-radius: var(--r-3);
    padding: var(--s-5);
  }
  .step-label {
    font-family: var(--f-display); font-size: 16px; letter-spacing: 0.04em;
    text-transform: uppercase; display: flex; align-items: center; margin-bottom: var(--s-4);
  }
  .step-label .num {
    background: var(--torii); color: #fff; width: 24px; height: 24px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center; font-size: 12px; margin-right: var(--s-3);
  }
  .opts { display: flex; gap: var(--s-3); flex-wrap: wrap; }
  .opt {
    border: 2px solid var(--sumi-4); background: var(--washi); border-radius: var(--r-2);
    padding: 10px 14px; cursor: pointer; font-size: 14px; color: var(--sumi);
    transition: all 0.18s var(--ease-koi); display: flex; flex-direction: column; gap: 2px; align-items: flex-start;
  }
  .opt:hover { border-color: var(--sumi-3); transform: translateY(-1px); }
  .opt.on { border-color: var(--torii); background: rgba(204,0,0,0.05); }
  .opt.on b, .opt.on span, .opt.on .name, .opt.on .price { color: var(--torii); }
  .opt b { font-weight: 600; }
  .opt span { font-size: 12px; color: var(--sumi-3); }
  .opt-base { min-width: 120px; align-items: center; text-align: center; }
  .opt-base .icon { font-size: 22px; }
  .opt-base .name { font-weight: 600; font-size: 13px; }
  .opt-base .price { font-family: var(--f-display); letter-spacing: 0.04em; font-size: 12px; }
  .opt.size { width: 48px; height: 48px; align-items: center; justify-content: center; font-family: var(--f-display); font-size: 15px; }

  .swatches { display: flex; gap: var(--s-3); flex-wrap: wrap; }
  /* Swatches are created in JS so we must escape Astro's CSS scoping
   * (the dynamic <button>s don't carry the data-astro-cid attribute). */
  .swatches :global(.swatch) {
    width: 40px; height: 40px; border-radius: 50%; cursor: pointer;
    border: 2px solid var(--sumi-4); box-shadow: inset 0 0 0 2px var(--washi);
    transition: transform 0.15s var(--ease-koi);
    padding: 0; background: transparent;
  }
  .swatches :global(.swatch:hover) { transform: scale(1.08); }
  .swatches :global(.swatch.on) { border-color: var(--torii); box-shadow: inset 0 0 0 2px var(--washi), 0 0 0 2px var(--torii); }

  .tabs { display: flex; gap: 4px; background: var(--washi-2); padding: 4px; border-radius: var(--r-2); margin-bottom: var(--s-4); }
  .tab {
    flex: 1; padding: 8px; border: none; background: transparent; cursor: pointer;
    font-family: var(--f-display); letter-spacing: 0.06em; text-transform: uppercase; font-size: 13px;
    border-radius: 6px; color: var(--sumi-2);
  }
  .tab.on { background: var(--sumi); color: #fff; }

  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px,1fr)); gap: var(--s-3); }
  .g-item {
    border: 2px solid var(--sumi-4); background: var(--washi); border-radius: var(--r-2);
    padding: 8px; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 4px;
    transition: all 0.18s;
  }
  .g-item:hover { border-color: var(--sumi-3); }
  .g-item.on { border-color: var(--torii); box-shadow: var(--e-torii); }
  .g-img { font-size: 32px; }
  .g-name { font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--sumi-3); }

  .dropzone {
    display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center;
    border: 2px dashed var(--sumi-4); border-radius: var(--r-3); padding: var(--s-7) var(--s-5);
    cursor: pointer; transition: all 0.2s;
  }
  .dropzone:hover, .dropzone.drag { border-color: var(--torii); background: rgba(204,0,0,0.04); }
  .dz-emoji { font-size: 28px; }
  .dz-title { font-family: var(--f-display); letter-spacing: 0.04em; text-transform: uppercase; font-size: 16px; }
  .dz-sub { font-size: 12px; max-width: 34ch; }
  .upload-tools { margin-top: var(--s-4); display: flex; flex-direction: column; gap: var(--s-3); }
  .tol-label { display: flex; flex-direction: column; gap: 6px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sumi-3); }
  .tol-label input { accent-color: var(--torii); }
  .tool-btns { display: flex; gap: 8px; flex-wrap: wrap; }
  .tiny { font-size: 11px; }

  /* ── Summary ───────────────────────────── */
  .sum-card { background: var(--sumi); color: #fff; border-radius: var(--r-3); padding: var(--s-6); }
  .total { font-family: var(--f-display); font-size: 44px; letter-spacing: 0.04em; line-height: 1; margin-top: 6px; }
  .brk { font-size: 13px; color: var(--w70); margin-top: var(--s-3); line-height: 1.5; min-height: 1.4em; }
  .actions { display: flex; flex-direction: column; gap: var(--s-3); margin-top: var(--s-5); }
  .actions .btn { justify-content: center; }
  .actions .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .hint { font-size: 12px; color: var(--w50); margin-top: var(--s-4); line-height: 1.5; }

  /* ── Size-guide button + modal ─────────── */
  .size-guide-link {
    margin-left: auto; font-size: 11px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--torii); background: none; border: none;
    cursor: pointer; padding: 4px 6px; font-weight: 600;
  }
  .size-guide-link:hover { text-decoration: underline; }

  .modal { position: fixed; inset: 0; z-index: 9999; display: none; align-items: center; justify-content: center; padding: var(--s-4); }
  .modal[style*="display:flex"], .modal.open { display: flex !important; }
