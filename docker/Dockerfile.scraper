# Scraper worker — heavier image because of Playwright + Chromium.
# Kept separate from the API/worker image so the rest of the stack stays slim.
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Chromium runtime deps for Playwright (Debian slim)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 curl ca-certificates \
        libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
        libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 \
        libcairo2 libasound2 libatspi2.0-0 fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

# Install Chromium (skip other browsers to keep image small)
RUN python -m playwright install chromium --with-deps || python -m playwright install chromium

RUN useradd -m -u 10001 app && chown -R app:app /ms-playwright
COPY --chown=app:app api /app/api
COPY --chown=app:app workers /app/workers
USER app

CMD ["python", "-m", "workers.scraper_worker"]
