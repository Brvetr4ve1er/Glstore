# ---- Runtime ----
ENVIRONMENT=development
DEBUG=true
APP_NAME=GLstore API

# ---- Database (asyncpg driver) ----
POSTGRES_USER=glstore
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=glstore
DATABASE_URL=postgresql+asyncpg://glstore:change_me_in_production@db:5432/glstore
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace_with_64_char_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14
BCRYPT_ROUNDS=12

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,https://admin.glstore.dz,https://glstore.dz

# ---- Cloudflare R2 ----
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=glstore-media
R2_PUBLIC_BASE=https://cdn.glstore.dz

# ---- Workers ----
EVENT_WORKER_BATCH_SIZE=50
EVENT_WORKER_POLL_INTERVAL_S=1.0
RESERVATION_TTL_MINUTES=30

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# Serverless / single-store deployment (Vercel + Neon) — see DEPLOY.md
# ----------------------------------------------------------------------------
# Leave these at their defaults for the Docker Compose stack. On Vercel, set:
#   ENVIRONMENT=production
#   DB_SERVERLESS=true            # NullPool + pgbouncer-safe asyncpg
#   RUN_STARTUP_MIGRATIONS=false  # schema applied once via init_remote_db.py
#   SINGLE_STORE_MODE=true        # serve the one store on any host (*.vercel.app)
#   ALLOWED_HOSTS=*               # accept the platform subdomain host
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx.neon.tech/glstore
#   CORS_ORIGINS=https://<your-project>.vercel.app
# ----------------------------------------------------------------------------
DB_SERVERLESS=false
RUN_STARTUP_MIGRATIONS=true
SINGLE_STORE_MODE=false
ALLOWED_HOSTS=*.glstore.dz,glstore.dz
