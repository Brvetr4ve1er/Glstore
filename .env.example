# ---- Runtime ----
ENVIRONMENT=development
DEBUG=true
APP_NAME=GLstore API

# ---- Database (asyncpg driver) ----
POSTGRES_USER=glstore
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=glstore
DATABASE_URL=postgresql+asyncpg://glstore:change_me_in_production@db:5432/glstore
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace_with_64_char_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14
BCRYPT_ROUNDS=12

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,https://admin.glstore.dz,https://glstore.dz

# ---- Cloudflare R2 ----
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=glstore-media
R2_PUBLIC_BASE=https://cdn.glstore.dz

# ---- Workers ----
EVENT_WORKER_BATCH_SIZE=50
EVENT_WORKER_POLL_INTERVAL_S=1.0
RESERVATION_TTL_MINUTES=30

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- Customer sign-in (phone OTP) ----
# "console" prints codes to the local terminal and ONLY works when
# ENVIRONMENT=development and DB_SERVERLESS=false. Anywhere else phone login
# answers 503 until a real SMS provider is wired (api/services/sms/).
SMS_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=10
OTP_MAX_PER_STORE_PER_HOUR=300
CUSTOMER_SESSION_TTL_DAYS=30

# ---- Financing ----
# Leave false until the legal/compliance review has happened. While false,
# the simulator labels every figure an estimate and no application status
# reads as approved. Financing rules themselves are created in the admin API;
# none ship with the platform.
FINANCING_TERMS_PUBLIC=false

# ---- Applicant documents (ID, payslips…) ----
# "local" writes under LOCAL_DOCUMENTS_DIR and ONLY works in development off
# serverless. Live: DOCUMENTS_STORAGE=r2 with a PRIVATE bucket that is not
# R2_BUCKET (that one backs the public CDN). Until then uploads answer 503.
DOCUMENTS_STORAGE=local
R2_DOCUMENTS_BUCKET=
LOCAL_DOCUMENTS_DIR=.local_documents
DOCUMENT_MAX_BYTES=10485760
MAX_DOCUMENTS_PER_APPLICATION=20

# ============================================================================
# Serverless / single-store deployment (Vercel + Neon) — see DEPLOY.md
# ----------------------------------------------------------------------------
# Leave these at their defaults for the Docker Compose stack. On Vercel, set:
#   ENVIRONMENT=production
#   DB_SERVERLESS=true            # NullPool + pgbouncer-safe asyncpg
#   RUN_STARTUP_MIGRATIONS=false  # schema applied once via init_remote_db.py
#   SINGLE_STORE_MODE=true        # serve the one store on any host (*.vercel.app)
#   ALLOWED_HOSTS=*               # accept the platform subdomain host
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx.neon.tech/glstore
#   CORS_ORIGINS=https://<your-project>.vercel.app
# ----------------------------------------------------------------------------
DB_SERVERLESS=false
RUN_STARTUP_MIGRATIONS=true
SINGLE_STORE_MODE=false
ALLOWED_HOSTS=*.glstore.dz,glstore.dz
